---
import '../styles/global.css';
import { person, site } from '../data/profile';

interface Props {
  title: string;
  description?: string;
}

const { title, description = person.summary } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Root-relative anchors work from the home page and from every project page.
const sections = [
  { href: '/#highlights', label: 'Highlights' },
  { href: '/#about', label: 'About' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <nav class="wrap nav-inner" aria-label="Main">
        <a class="home" href="/">{person.name}</a>
        <ul>
          {
            sections.map((s) => (
              <li>
                <a href={s.href}>{s.label}</a>
              </li>
            ))
          }
        </ul>
        <a class="btn cv" href="/cv.pdf" download>CV</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <span>&copy; {new Date().getFullYear()} {person.name}</span>
        <span class="sep" aria-hidden="true"></span>
        <a href={`mailto:${person.email}?subject=Feedback on ${site.domain}`}>Send feedback</a>
        <span class="updated">Updated {site.revision}</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 20;
    background: var(--bg);
    padding: 0.5rem 1rem;
    border-radius: 999px;
  }

  /* Translucent chrome: content scrolls underneath, no opaque strip */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--material);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    box-shadow: 0 1px 0 transparent;
  }

  /* Scroll edge effect: the hairline only appears once content is underneath */
  @supports (animation-timeline: scroll()) {
    .nav {
      animation: edge linear both;
      animation-timeline: scroll(root);
      animation-range: 0 3rem;
    }
    @keyframes edge {
      to {
        box-shadow: 0 1px 0 var(--separator);
      }
    }
  }
  @supports not (animation-timeline: scroll()) {
    .nav {
      box-shadow: 0 1px 0 var(--separator);
    }
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 3.25rem;
  }

  .home {
    color: var(--fg);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
    text-decoration: none;
  }

  .nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    min-width: 0;
  }
  .nav ul::-webkit-scrollbar {
    display: none;
  }
  .nav li {
    white-space: nowrap;
  }
  .nav ul a {
    color: var(--fg);
    opacity: 0.8;
    font-size: 0.8125rem;
    letter-spacing: -0.005em;
    text-decoration: none;
    transition: opacity 150ms ease;
  }
  .nav ul a:hover {
    opacity: 1;
  }

  .cv {
    font-size: 0.8125rem;
    padding: 0.35rem 0.9rem;
  }

  @media (max-width: 760px) {
    .nav-inner {
      gap: 1rem;
    }
    /* Links stay reachable: they scroll sideways and fade at the edges */
    .nav ul {
      gap: 1.25rem;
      padding-inline: 0.75rem;
      mask-image: linear-gradient(90deg, transparent, #000 0.75rem, #000 calc(100% - 0.75rem), transparent);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .nav {
      background: var(--bg);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  @media (prefers-contrast: more) {
    .nav {
      background: var(--bg);
      box-shadow: 0 1px 0 var(--separator);
    }
  }

  .foot {
    background: var(--bg-alt);
    color: var(--fg-2);
    font-size: 0.75rem;
    letter-spacing: 0;
  }
  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding-block: 1.5rem 2.5rem;
    border-top: 1px solid var(--separator);
  }
  .foot a {
    color: var(--fg);
  }
  .sep {
    width: 1px;
    height: 0.8rem;
    background: var(--separator);
  }
  .updated {
    margin-left: auto;
  }
</style>
