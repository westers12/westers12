---
// Functional block diagram: a left-to-right signal chain.
// On narrow screens it turns into a top-to-bottom chain.
interface Block {
  label: string;
  detail?: string;
}
interface Group {
  label: string;
  span: number; // how many consecutive blocks this group covers
}
interface Props {
  blocks: Block[];
  groups?: Group[];
  animate?: boolean;
  label: string; // accessible description of the whole diagram
}

const { blocks, groups, animate = false, label } = Astro.props;
const isTbd = (s: string) => s.trim().toUpperCase() === 'TBD';

let col = 1;
const placedGroups = (groups ?? []).map((g) => {
  const placed = { ...g, start: col };
  col += g.span;
  return placed;
});
---

<div class:list={['diagram', { animate }]} style={`--n: ${blocks.length}`}>
  <ol aria-label={label}>
    {
      blocks.map((b, i) => (
        <li style={`--i: ${i}`}>
          <span class:list={['label', { tbd: isTbd(b.label) }]}>{b.label}</span>
          {b.detail && <span class="detail">{b.detail}</span>}
        </li>
      ))
    }
  </ol>
  {
    placedGroups.length > 0 && (
      <div class="groups" aria-hidden="true">
        {placedGroups.map((g) => (
          <span style={`grid-column: ${g.start} / span ${g.span}`}>{g.label}</span>
        ))}
      </div>
    )
  }
</div>

<style>
  .diagram {
    --gap: 2.25rem;
    --line: 2px;
  }

  ol,
  .groups {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    column-gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1rem 1.1rem;
    min-height: 6rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
  }

  /* Connector into the next tile, ending in a small dot */
  li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 100%;
    width: var(--gap);
    height: var(--line);
    margin-top: calc(var(--line) / -2);
    background: linear-gradient(90deg, var(--fill), var(--accent));
    border-radius: var(--line);
    transform-origin: left center;
  }
  li:not(:first-child)::before {
    content: '';
    position: absolute;
    right: 100%;
    top: 50%;
    width: 7px;
    height: 7px;
    margin: -3.5px -3.5px 0 0;
    border-radius: 50%;
    background: var(--accent);
    z-index: 1;
  }

  .label {
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .label.tbd {
    align-self: flex-start;
  }
  .detail {
    font-size: 0.8125rem;
    color: var(--fg-2);
    letter-spacing: 0;
  }

  /* Group labels: soft capsules under the tiles they cover */
  .groups {
    margin-top: 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--fg-2);
    letter-spacing: 0.01em;
  }
  .groups span {
    display: flex;
    justify-content: center;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: var(--fill);
  }

  /*
   * One load moment: the signal travels down the chain.
   * Tiles arrive on a critically damped spring (no overshoot: nothing was flicked).
   */
  @media (prefers-reduced-motion: no-preference) {
    .animate li {
      animation: arrive var(--spring-dur) var(--spring) both;
      animation-delay: calc(var(--i) * 0.14s + 0.1s);
    }
    .animate li:not(:last-child)::after {
      animation: trace 0.35s var(--spring) both;
      animation-delay: calc(var(--i) * 0.14s + 0.3s);
    }
    .animate li:not(:first-child)::before {
      animation: pop 0.3s var(--spring) both;
      animation-delay: calc(var(--i) * 0.14s + 0.2s);
    }
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateX(-0.75rem) scale(0.96);
    }
  }
  @keyframes trace {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes pop {
    from {
      transform: scale(0);
    }
  }

  @media (max-width: 760px) {
    ol {
      grid-template-columns: 1fr;
      row-gap: var(--gap);
      column-gap: 0;
    }
    li {
      min-height: 0;
    }
    li:not(:last-child)::after {
      top: 100%;
      left: 50%;
      width: var(--line);
      height: var(--gap);
      margin: 0 0 0 calc(var(--line) / -2);
      background: linear-gradient(180deg, var(--fill), var(--accent));
      transform-origin: center top;
    }
    li:not(:first-child)::before {
      right: auto;
      left: 50%;
      top: 0;
      margin: -3.5px 0 0 -3.5px;
    }
    @keyframes trace {
      from {
        transform: scaleY(0);
      }
    }
    @keyframes arrive {
      from {
        opacity: 0;
        transform: translateY(-0.75rem) scale(0.96);
      }
    }
    .groups {
      display: none;
    }
  }
</style>
