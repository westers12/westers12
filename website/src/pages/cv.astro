---
// Printable CV. `npm run cv` turns this page into public/cv.pdf.
import '@fontsource-variable/archivo/standard.css';
import '../styles/global.css';
import { person, site, features, skillGroups, work, education, description } from '../data/profile';

const links = [person.linkedin, person.github].filter(Boolean) as string[];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CV, {person.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <p class="screen-note">
      Printable CV. <a href="/cv.pdf" download>Download the PDF</a> or <a href="/">go back to the site</a>.
    </p>
    <article class="sheet">
      <header class="band">
        <span>{site.partNumber}</span>
        <span>{site.domain}</span>
      </header>

      <div class="head">
        <div>
          <h1>{person.name}</h1>
          <p class="role">{person.role}</p>
        </div>
        <ul class="contact">
          <li><a href={`mailto:${person.email}`}>{person.email}</a></li>
          <li>{person.location}</li>
          {links.map((l) => <li><a href={l}>{l.replace(/^https?:\/\/(www\.)?/, '')}</a></li>)}
          <li><a href={`https://${site.domain}`}>{site.domain}</a></li>
        </ul>
      </div>

      <p class="summary">{person.summary}</p>

      <div class="cols">
        <div class="main">
          <h2>Work</h2>
          {
            work.map((r) => (
              <div class="entry">
                <p class="when">{r.period}</p>
                <p><strong>{r.title}</strong>, {r.org}</p>
                {r.details && <p class="det">{r.details}</p>}
              </div>
            ))
          }

          <h2>Education</h2>
          {
            education.map((r) => (
              <div class="entry">
                <p class="when">{r.period}</p>
                <p><strong>{r.title}</strong>, {r.org}</p>
                {r.details && <p class="det">{r.details}</p>}
              </div>
            ))
          }

          <h2>About</h2>
          <p class="det">{description[2]}</p>
        </div>

        <aside class="side">
          <h2>Highlights</h2>
          <ul>{features.map((f) => <li>{f}</li>)}</ul>

          {
            skillGroups.map((g) => (
              <>
                <h2>{g.title}</h2>
                <ul class="plain">{g.skills.map((s) => <li>{s.name}</li>)}</ul>
              </>
            ))
          }

          <h2>Languages</h2>
          <ul class="plain">{person.languages.map((l) => <li>{l}</li>)}</ul>
          <h2>Other</h2>
          <ul class="plain">{person.extras.map((l) => <li>{l}</li>)}</ul>
        </aside>
      </div>
    </article>
  </body>
</html>

<style>
  @page {
    size: A4;
    margin: 0;
  }

  body {
    background: var(--shade);
    font-size: 10pt;
    line-height: 1.4;
  }

  .screen-note {
    max-width: 210mm;
    margin: 1rem auto;
    padding: 0 1rem;
    font-size: var(--step--1);
  }

  .sheet {
    width: 210mm;
    min-height: 297mm;
    margin: 0 auto 2rem;
    background: var(--paper);
    box-shadow: 0 1px 3px rgba(24, 33, 43, 0.2);
  }

  .band {
    display: flex;
    justify-content: space-between;
    background: var(--mask);
    color: var(--paper);
    padding: 3mm 14mm;
    font-weight: 700;
    font-stretch: var(--narrow);
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .head {
    display: flex;
    justify-content: space-between;
    gap: 8mm;
    padding: 9mm 14mm 0;
    align-items: end;
  }

  h1 {
    font-size: 30pt;
    font-weight: 800;
    font-stretch: 70%;
  }

  .role {
    color: var(--mask);
    font-size: 13pt;
    font-stretch: var(--narrow);
    font-weight: 600;
    margin: 1mm 0 0;
  }

  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: right;
    font-size: 9pt;
  }

  .summary {
    margin: 5mm 14mm 0;
    padding-bottom: 5mm;
    border-bottom: 2px solid var(--ink);
    max-width: none;
    font-size: 10.5pt;
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 62mm;
    gap: 9mm;
    padding: 2mm 14mm 12mm;
  }

  h2 {
    font-size: 12pt;
    font-weight: 750;
    color: var(--mask);
    margin: 5mm 0 2mm;
  }

  .entry {
    margin-bottom: 3.5mm;
    break-inside: avoid;
  }
  .entry p {
    margin: 0;
  }
  .when {
    font-size: 8.5pt;
    color: var(--ink-soft);
  }
  .det {
    color: var(--ink-soft);
    font-size: 9.5pt;
  }

  .side ul {
    margin: 0;
    padding-left: 4mm;
    font-size: 9.5pt;
  }
  .side li {
    margin-bottom: 1mm;
  }
  .side ul.plain {
    list-style: none;
    padding: 0;
  }

  @media screen and (max-width: 820px) {
    .sheet {
      width: auto;
      min-height: 0;
      margin: 0 0.5rem 2rem;
    }
    .head,
    .cols {
      display: block;
      padding-inline: 1rem;
    }
    .contact {
      text-align: left;
      margin-top: 1rem;
    }
    .band {
      padding-inline: 1rem;
    }
    .summary {
      margin-inline: 1rem;
    }
  }

  @media print {
    body {
      background: none;
    }
    .screen-note {
      display: none;
    }
    .sheet {
      margin: 0;
      box-shadow: none;
    }
    a {
      color: var(--ink);
      text-decoration: none;
    }
  }
</style>
