---
// Printable CV. `npm run cv` turns this page into public/cv.pdf.
import '../styles/global.css';
import { person, site, features, skillGroups, work, education, description } from '../data/profile';

const links = [person.linkedin, person.github].filter(Boolean) as string[];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CV, {person.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <p class="screen-note">
      Printable CV. <a href="/cv.pdf" download>Download the PDF</a> or <a href="/">go back to the site</a>.
    </p>
    <article class="sheet">
      <header class="top">
        <span>Curriculum Vitae</span>
        <span>{site.domain}</span>
      </header>

      <div class="head">
        <div>
          <h1>{person.name}</h1>
          <p class="role">{person.role}</p>
        </div>
        <ul class="contact">
          <li><a href={`mailto:${person.email}`}>{person.email}</a></li>
          <li>{person.location}</li>
          {links.map((l) => <li><a href={l}>{l.replace(/^https?:\/\/(www\.)?/, '')}</a></li>)}
          <li><a href={`https://${site.domain}`}>{site.domain}</a></li>
        </ul>
      </div>

      <p class="summary">{person.summary}</p>

      <div class="cols">
        <div class="main">
          <h2>Work</h2>
          {
            work.map((r) => (
              <div class="entry">
                <p class="when">{r.period}</p>
                <p><strong>{r.title}</strong>, {r.org}</p>
                {r.details && <p class="det">{r.details}</p>}
              </div>
            ))
          }

          <h2>Education</h2>
          {
            education.map((r) => (
              <div class="entry">
                <p class="when">{r.period}</p>
                <p><strong>{r.title}</strong>, {r.org}</p>
                {r.details && <p class="det">{r.details}</p>}
              </div>
            ))
          }

          <h2>About</h2>
          <p class="det">{description[2]}</p>
        </div>

        <aside class="side">
          <h2>Highlights</h2>
          <ul>{features.map((f) => <li>{f.text}</li>)}</ul>

          {
            skillGroups.map((g) => (
              <>
                <h2>{g.title}</h2>
                <ul class="plain">{g.skills.map((s) => <li>{s.name}</li>)}</ul>
              </>
            ))
          }

          <h2>Languages</h2>
          <ul class="plain">{person.languages.map((l) => <li>{l}</li>)}</ul>
          <h2>Other</h2>
          <ul class="plain">{person.extras.map((l) => <li>{l}</li>)}</ul>
        </aside>
      </div>
    </article>
  </body>
</html>

<style>
  @page {
    size: A4;
    margin: 0;
  }

  /* Paper is always light: pin the light palette even when the OS is in dark mode */
  :global(html:root) {
    color-scheme: light;
    --bg-alt: #f5f5f7;
    --surface: #ffffff;
    --fg: #1d1d1f;
    --fg-2: #6e6e73;
    --fg-3: #86868b;
    --separator: rgba(60, 60, 67, 0.16);
    --link: #0066cc;
  }

  /* html + body outranks the site's global body rule, which loads after this */
  :global(html body) {
    background: var(--bg-alt);
    font-size: 10pt;
    line-height: 1.45;
    letter-spacing: -0.003em;
  }

  .screen-note {
    max-width: 210mm;
    margin: 1.25rem auto;
    padding: 0 1rem;
    font-size: var(--t-small);
    color: var(--fg-2);
  }

  .sheet {
    width: 210mm;
    min-height: 297mm;
    margin: 0 auto 2.5rem;
    padding: 12mm 15mm 14mm;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .top {
    display: flex;
    justify-content: space-between;
    font-size: 8.5pt;
    font-weight: 600;
    color: var(--fg-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .head {
    display: flex;
    justify-content: space-between;
    gap: 8mm;
    margin-top: 9mm;
    align-items: end;
  }

  /* Large type: tight leading, negative tracking */
  h1 {
    font-size: 32pt;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .role {
    color: var(--fg-2);
    font-size: 13pt;
    font-weight: 500;
    letter-spacing: -0.015em;
    margin: 1.5mm 0 0;
  }

  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: right;
    font-size: 9pt;
    color: var(--fg-2);
  }

  .summary {
    margin: 6mm 0 0;
    padding-bottom: 6mm;
    border-bottom: 1px solid var(--separator);
    max-width: none;
    font-size: 10.5pt;
    letter-spacing: -0.008em;
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 60mm;
    gap: 10mm;
    padding-top: 1mm;
  }

  h2 {
    font-size: 8.5pt;
    font-weight: 600;
    color: var(--fg-2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 6mm 0 2.5mm;
  }

  .entry {
    margin-bottom: 3.5mm;
    break-inside: avoid;
  }
  .entry p {
    margin: 0;
  }
  .entry strong {
    font-weight: 600;
  }
  .when {
    font-size: 8.5pt;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .det {
    color: var(--fg-2);
    font-size: 9.5pt;
  }

  .side ul {
    margin: 0;
    padding-left: 4mm;
    font-size: 9.5pt;
  }
  .side li {
    margin-bottom: 1mm;
  }
  .side ul.plain {
    list-style: none;
    padding: 0;
  }

  @media screen and (max-width: 820px) {
    .sheet {
      width: auto;
      min-height: 0;
      margin: 0 0.75rem 2rem;
      padding: 1.5rem 1.25rem;
    }
    .head,
    .cols {
      display: block;
    }
    .contact {
      text-align: left;
      margin-top: 1rem;
    }
  }

  @media print {
    :global(html body) {
      background: none;
    }
    .screen-note {
      display: none;
    }
    .sheet {
      margin: 0;
      border-radius: 0;
      box-shadow: none;
    }
    a {
      color: var(--fg);
      text-decoration: none;
    }
  }
</style>
